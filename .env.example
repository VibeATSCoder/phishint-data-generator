# Copy this file to .env and fill in your values

# Required for technique 23 (AI cloning)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: for technique 8 (Clearbit favicon loading)
CLEARBIT_API_KEY=

# Server settings
HOST=0.0.0.0
PORT=8009
DEBUG=false

# Upload limits (per-request, enforced server-side)
# Raise these if you're feeding very large pages or bulk archives.
MAX_HTML_SIZE_BYTES=5242880
MAX_SCREENSHOT_SIZE_BYTES=10485760
MAX_CSV_SIZE_BYTES=209715200
MAX_INPUT_ZIP_SIZE_BYTES=2147483648
MAX_TECHNIQUES_PER_REQUEST=25

# Per-technique screenshot rendering (Playwright)
# - SCREENSHOT_ENABLED=false disables the whole pipeline (faster generation,
#   no PNG artefacts in the output ZIP).
# - SCREENSHOT_BROWSER_RECYCLE_AFTER caps memory by closing + relaunching
#   Chromium after N rendered pages.
SCREENSHOT_ENABLED=true
SCREENSHOT_TIMEOUT_MS=15000
SCREENSHOT_VIEWPORT_WIDTH=1366
SCREENSHOT_VIEWPORT_HEIGHT=768
SCREENSHOT_BROWSER_RECYCLE_AFTER=100

# Where bulk jobs persist input/output. Mount this as a Docker volume so
# job artefacts survive container restarts. Resolved paths inside legitimate_dir
# uploads are also forced to stay under this root.
DATA_DIR=/data

# Bulk job pipeline limits
# - BULK_MAX_ENTRIES: server-side cap on entries per job (manifest or CSV).
# - BULK_MAX_ZIP_UNCOMPRESSED_BYTES: refuses ZIP bombs whose declared
#   uncompressed total exceeds this. Default 10 GB.
BULK_MAX_ENTRIES=12000
BULK_MAX_ZIP_UNCOMPRESSED_BYTES=10737418240

# Bulk job concurrency
# - BULK_DEFAULT_CONCURRENCY: per-job default for /generate-bulk
# - BULK_MAX_CONCURRENCY: hard server-side ceiling for generation jobs.
#   Also sizes the dedicated ThreadPoolExecutor installed at startup so
#   asyncio.to_thread(engine.run, ...) can actually parallelise up to this
#   value. ~30-80 MB per worker depending on page size.
# - CRAWL_DEFAULT_CONCURRENCY: per-job default for /crawl-bulk (higher
#   because crawling is I/O bound; most time is waiting on remote servers)
# - CRAWL_MAX_CONCURRENCY: hard server-side ceiling for crawl. Each
#   parallel worker holds an open Chromium context (~80-150 MB), so set
#   this to fit your container RAM.
BULK_DEFAULT_CONCURRENCY=4
BULK_MAX_CONCURRENCY=16
CRAWL_DEFAULT_CONCURRENCY=8
CRAWL_MAX_CONCURRENCY=32

# Two-phase per-attempt timeouts for crawling (seconds).
# - CRAWL_UNREACHABLE_TIMEOUT_S: how long to wait for the FIRST RESPONSE
#   (DNS + TCP + first byte). If a site doesn't respond in this window
#   it's marked unreachable and the next proxy (or next entry) is tried.
#   Keep this short - there's no point waiting 30s for a dead server.
# - CRAWL_PARTIAL_TIMEOUT_S: once the navigation has committed, how
#   long to wait for the page to finish (assets, JS, networkidle). On
#   timeout we don't fail - we salvage whatever DOM has parsed.
# Total wall clock per attempt ≈ unreachable + partial.
CRAWL_UNREACHABLE_TIMEOUT_S=10
CRAWL_PARTIAL_TIMEOUT_S=25
